{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nitrictech/cli/pkg/infra/schema",
  "$ref": "#/$defs/Schema",
  "$defs": {
    "Bucket": {
      "properties": {
        "name": {
          "type": "string"
        },
        "triggers": {
          "items": {
            "$ref": "#/$defs/BucketTrigger"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "triggers"
      ]
    },
    "BucketTrigger": {
      "properties": {
        "triggerType": {
          "type": "string",
          "enum": [
            "write",
            "delete"
          ]
        },
        "keyPrefix": {
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/BucketTriggerTarget"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "triggerType",
        "keyPrefix",
        "target"
      ]
    },
    "BucketTriggerTarget": {
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "service"
          ]
        },
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "type",
        "name",
        "path"
      ]
    },
    "DockerFileRuntime": {
      "properties": {
        "dockerfile": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "dockerfile"
      ]
    },
    "DockerImageRuntime": {
      "properties": {
        "image": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "image"
      ]
    },
    "Entrypoint": {
      "properties": {
        "name": {
          "type": "string"
        },
        "targets": {
          "items": {
            "$ref": "#/$defs/Target"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "targets"
      ]
    },
    "Runtime": {
      "oneOf": [
        {
          "required": [
            "dockerfile"
          ],
          "title": "dockerfile"
        },
        {
          "required": [
            "docker"
          ],
          "title": "docker"
        }
      ],
      "properties": {
        "dockerfile": {
          "$ref": "#/$defs/DockerFileRuntime"
        },
        "docker": {
          "$ref": "#/$defs/DockerImageRuntime"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Schema": {
      "properties": {
        "services": {
          "items": {
            "$ref": "#/$defs/Service"
          },
          "type": "array"
        },
        "entrypoints": {
          "items": {
            "$ref": "#/$defs/Entrypoint"
          },
          "type": "array"
        },
        "websites": {
          "items": {
            "$ref": "#/$defs/Website"
          },
          "type": "array"
        },
        "topics": {
          "items": {
            "$ref": "#/$defs/Topic"
          },
          "type": "array"
        },
        "buckets": {
          "items": {
            "$ref": "#/$defs/Bucket"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "services",
        "entrypoints",
        "websites",
        "topics",
        "buckets"
      ]
    },
    "Service": {
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "serverless",
            "container"
          ]
        },
        "port": {
          "type": "integer"
        },
        "lang": {
          "type": "string"
        },
        "runtime": {
          "$ref": "#/$defs/Runtime"
        },
        "dev": {
          "$ref": "#/$defs/ServiceDev"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "type",
        "port",
        "lang",
        "runtime"
      ]
    },
    "ServiceDev": {
      "properties": {
        "port": {
          "type": "integer"
        },
        "run": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "port",
        "run"
      ]
    },
    "Target": {
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "service",
            "website"
          ]
        },
        "targetName": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "type",
        "targetName",
        "path"
      ]
    },
    "Topic": {
      "properties": {
        "name": {
          "type": "string"
        },
        "triggers": {
          "items": {
            "$ref": "#/$defs/TopicTrigger"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "triggers"
      ]
    },
    "TopicTrigger": {
      "properties": {
        "target": {
          "$ref": "#/$defs/TopicTriggerTarget"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "target"
      ]
    },
    "TopicTriggerTarget": {
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "service"
          ]
        },
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "type",
        "name",
        "path"
      ]
    },
    "Website": {
      "properties": {
        "name": {
          "type": "string"
        },
        "baseDir": {
          "type": "string"
        },
        "assetDir": {
          "type": "string"
        },
        "errorPage": {
          "type": "string"
        },
        "build": {
          "type": "string"
        },
        "dev": {
          "$ref": "#/$defs/WebsiteDev"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "baseDir",
        "assetDir",
        "errorPage"
      ]
    },
    "WebsiteDev": {
      "properties": {
        "url": {
          "type": "string"
        },
        "command": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "url",
        "command"
      ]
    }
  }
}
